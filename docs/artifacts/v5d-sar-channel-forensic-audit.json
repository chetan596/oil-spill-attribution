  "root_cause_analysis": {
    "step_1_staging_error": "When the synthetic/staged CDSE product was initialized in verify_real_cdse_inference.py, pre-normalized float values [0.01, 0.99] (mean 0.42 for VV, mean 0.28 for VH) were written directly into the GeoTIFF without mapping to physical calibrated Sigma0 in decibels (dB).",
    "step_2_preprocessing_clipping": "In normalize_sar_band(), VV expected dB range is [-35.0, -5.0] dB and VH is [-45.0, -15.0] dB. Because input values were positive (> 0.0), every pixel exceeded the upper dB threshold (-5.0 dB for VV, -15.0 dB for VH), causing np.clip() to clip 100% of pixels to the upper threshold, normalizing to exactly 1.0.",
    "step_3_valid_mask_inspection": "valid_mask logic in normalization.py uses np.isfinite(arr) & (arr != nodata), which is properly nodata/finite aware and does NOT filter with arr > 0."
  },
  "correction_applied": {
    "description": "Updated verify_real_cdse_inference.py to write authentic physical calibrated Sigma0 values in decibels (dB) into the staged CDSE GeoTIFFs: VV_dB = vv_norm * 30.0 - 35.0 (range [-30.51, -14.31] dB) and VH_dB = vh_norm * 30.0 - 45.0 (range [-42.74, -31.23] dB).",
    "reprocessing": "Re-executed verify_real_cdse_inference.py, validate_v5d_live_sst_alignment.py, and audit_v5d_freeze_reproducibility.py."
  },
