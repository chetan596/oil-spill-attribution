NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oil_spill_db?schema=public

# Redis & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ML Service Configuration (FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=local_ml_internal_key

# Copernicus Data Space Ecosystem (CDSE)
CDSE_USERNAME=
CDSE_PASSWORD=

# ==============================================================================
# AIS Telemetry Configuration (Phase 16.4 Part 7.2)
# ==============================================================================
# AIS_PROVIDER explicitly selects the active AIS telemetry provider:
#   - openseafeed  (default, open-source community AIS network)
#   - marinetraffic (requires MARINETRAFFIC_API_KEY)
#   - aisstream     (requires AISSTREAM_API_KEY)
#   - demo          (ONLY allowed in non-production environments when AIS_DEMO_MODE=true)
AIS_PROVIDER=openseafeed

# AIS_DEMO_MODE: Explicit gate for demonstration transponder telemetry.
# Set to true ONLY for local development or test mocks.
# MUST BE FALSE IN PRODUCTION (enforced with hard error AIS_DEMO_DISABLED_IN_PRODUCTION).
AIS_DEMO_MODE=false

# OpenSeaFeed Configuration
# API key is OPTIONAL for the anonymous snapshot endpoint (10-min freshness).
# Unlocks higher rate limits and contributor tier when set.
OPENSEAFEED_API_KEY=
OPENSEAFEED_BASE_URL=https://stream.openseafeed.com

# MarineTraffic Configuration (Optional real provider)
MARINETRAFFIC_API_KEY=

# AISStream Configuration (Optional real provider)
AISSTREAM_API_KEY=

# ==============================================================================
# Historical AIS Telemetry Configuration (Phase 16.4 Part 2)
# ==============================================================================
# Global historical AIS provider supporting historical time-range vessel searches:
#   - global (default client, configurable REST endpoint for international waters)
#   - openseafeed (requires OPENSEAFEED_HISTORICAL_URL)
#   - marinetraffic (requires historical API access)
#   - demo (allowed ONLY in non-production with AIS_DEMO_MODE=true)
AIS_HISTORICAL_PROVIDER=global
AIS_HISTORICAL_API_URL=
AIS_HISTORICAL_API_KEY=
AIS_HISTORICAL_BEARER_TOKEN=
AIS_HISTORICAL_TIMEOUT_MS=30000

