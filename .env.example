# Node Backend Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oil_spill_db?schema=public

# Redis & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ML Service Configuration (FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=local_ml_internal_key

# External Data APIs
COPERNICUS_API_USER=your_copernicus_username
COPERNICUS_API_PASSWORD=your_copernicus_password
AIS_PROVIDER_KEY=your_ais_api_key
NOAA_WEATHER_API_KEY=your_noaa_key

# LLM Provider Configuration
GEMINI_API_KEY=your_google_gemini_api_key
LLM_MODEL=gemini-2.5-flash

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
