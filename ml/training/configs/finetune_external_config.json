  "experiment_purpose": "Fine-tune external ResNet-34 U-Net architecture. Phase 4 empirical benchmark demonstrated this architecture achieved the highest recall on drone imagery (0.9609), 0.8151 IoU on KERF, low inference latency (17.56 ms on RTX 5050), and balanced segmentation on the representative failure image (46.58% oil across 3 clean components) without wave oversegmentation.",
  "data_manifests": {
    "train_manifest": "ml/training/manifests/train_manifest.json",
    "val_manifest": "ml/training/manifests/val_manifest.json",
    "benchmark_manifest": "ml/training/manifests/benchmark_manifest.json",
    "sealed_test_manifest": "ml/training/manifests/sealed_test_manifest.json"
  },
  "class_mapping": {
    "target_mode": "BINARY_OIL_EXTRACTION",
    "foreground_classes": [1],
    "background_classes": [0, 2, 3]
  },
  "preprocessing": {
    "strategy": "ASPECT_PRESERVING_LETTERBOX",
    "target_width": 512,
    "target_height": 512,
    "interpolation_image": "BILINEAR",
    "interpolation_mask": "NEAREST",
    "pad_mode": "CONSTANT",
    "pad_value": 0,
